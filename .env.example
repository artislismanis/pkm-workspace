# Required
ANTHROPIC_API_KEY=sk-ant-xxxx

# Path to your Obsidian vault on the host
# WSL example: /mnt/c/Users/you/Documents/MyVault
PKM_VAULT_PATH=/mnt/c/Users/you/Documents/MyVault

# Git identity (used for commits inside the container)
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Optional: remap ttyd port (default 7681)
# TTYD_PORT=7681
