# Required
ANTHROPIC_API_KEY=sk-ant-xxxx

# Path to your Obsidian vault on the host
# WSL example: /mnt/c/Users/YOU/Documents/MyVault
PKM_VAULT_PATH=/mnt/c/Users/YOU/path/to/vault

# Optional: remap ttyd port (default 7681)
# TTYD_PORT=7681

# Optional: enable ttyd authentication
# TTYD_PASSWORD=changeme
