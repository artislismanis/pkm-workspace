{
	// ── Identity ─────────────────────────────────────────────
	"name": "PKM Workspace",

	// ── Build ────────────────────────────────────────────────
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},

	// ── Runtime ──────────────────────────────────────────────
	"remoteUser": "node",
	"runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

	// ── Workspace ────────────────────────────────────────────
	"workspaceFolder": "/workspace",
	"workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

	// ── Mounts ───────────────────────────────────────────────
	// Vault bind mount: update source path for your OS (see README.md § Setup)
	"mounts": [
		"source=/path/to/your/vault,target=/workspace/vault,type=bind,consistency=cached",
		"source=pkm-commandhistory,target=/commandhistory,type=volume",
		"source=pkm-claude-config-${devcontainerId},target=/home/node/.claude,type=volume"
	],

	// ── Environment ──────────────────────────────────────────
	// Shell history persistence + runtime tuning
	"containerEnv": {
		"HISTFILE": "/commandhistory/.zsh_history",
		"PROMPT_COMMAND": "history -a",
		"HISTSIZE": "10000",
		"HISTFILESIZE": "20000",
		"NODE_OPTIONS": "--max-old-space-size=4096",
		"CLAUDE_CONFIG_DIR": "/home/node/.claude",
		"POWERLEVEL9K_DISABLE_GITSTATUS": "true"
	},

	// ── Lifecycle ────────────────────────────────────────────
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	// ── Ports ────────────────────────────────────────────────
	// Available for markdown preview or local dev servers
	"forwardPorts": [8080, 3000],

	// ── Editor Customizations ────────────────────────────────
	"customizations": {
		"vscode": {
			"settings": {
				// Terminal: explicit profiles, zsh default
				"terminal.integrated.profiles.linux": {
					"zsh": { "path": "/bin/zsh", "icon": "terminal" },
					"bash": { "path": "/bin/bash", "icon": "terminal-bash" }
				},
				"terminal.integrated.defaultProfile.linux": "zsh",

				// Editor behaviour
				"editor.wordWrap": "on",
				"editor.minimap.enabled": false,
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"editor.codeActionsOnSave": {
					"source.fixAll.eslint": "explicit"
				},
				"files.autoSave": "afterDelay",
				"files.autoSaveDelay": 1000,

				// Hide Obsidian internals from file explorer
				"files.exclude": {
					"**/vault/.obsidian/plugins/*/main.js": true,
					"**/vault/.trash": true
				},
				// Exclude plugin build artifacts from search
				"search.exclude": {
					"**/vault/.obsidian/plugins/*/main.js": true,
					"**/vault/.obsidian/plugins/*/styles.css": true,
					"**/vault/.trash": true
				}
			},
			"extensions": [
				// Markdown & PKM
				"foam.foam-vscode",
				"yzhang.markdown-all-in-one",
				"bierner.markdown-preview-github-styles",
				"bierner.markdown-yaml-preamble",
				"bierner.markdown-footnotes",
				"bierner.markdown-checkbox",
				"davidanson.vscode-markdownlint",
				// Developer tooling
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"redhat.vscode-yaml",
				"gruntfuggly.todo-tree",
				"streetsidesoftware.code-spell-checker",
				// AI
				"anthropic.claude-code"
			]
		}
	}
}
